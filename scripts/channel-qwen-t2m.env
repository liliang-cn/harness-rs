# Mac-local qwen3.8:27b-mlx, reached through the t2m relay rather than
# localhost:11434 — the same route superleo and any off-Mac caller takes, so a
# bench run here measures the channel people actually use.
#
#   set -a; . scripts/channel-qwen-t2m.env; set +a
#
# The Mac agent is a workstation first: `max_concurrent: 1, max_queue: 0` in
# ~/.t2m/agent.yaml, so a parallel driver gets `no_capacity` rather than a
# queue. Keep bench drivers sequential on this channel.
HARNESS_BASE_URL="https://t2m.superleo.app/v1"
HARNESS_MODEL="qwen3.8:27b-mlx"

# Interactive shells get T2M_API_KEY from ~/.zshrc; a `cargo run` under a
# non-interactive shell does not, so fall back to reading it from there. Do not
# use ${VAR:?...} here — an unset var would abort the sourcing shell itself.
HARNESS_API_KEY="${T2M_API_KEY:-$(sed -n 's/^export T2M_API_KEY="\(.*\)"$/\1/p' "$HOME/.zshrc")}"

# The suite's budget for a whole task, which is a different thing from the HTTP
# bound on one model call and is not covered by it. At ~16 tok/s a task like
# grep-flood-trap takes 200s+, and the 120s default scores it `timeout` — an
# honest status, unlike the transport bugs, but still a slow model recorded as
# a failed task.
#
# HARNESS_HTTP_TIMEOUT_SECS is deliberately NOT set here. Since the
# completion/stream split its default is 300s, and a full run of this suite on
# this model reaches 10/10 without touching it. Set it only for something
# slower still — and note it is multiplied by HARNESS_RETRY_ATTEMPTS (6),
# because a timeout counts as transient.
BENCH_TIMEOUT_SECS="${BENCH_TIMEOUT_SECS:-900}"
