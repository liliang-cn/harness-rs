{
  "name": "@ai-gui/plugin-chart",
  "version": "0.20.1",
  "description": "ECharts chart plugin for AIGUI — static SVG, interactive, and 3D (echarts-gl).",
  "keywords": [
    "llm",
    "ai",
    "streaming",
    "markdown",
    "echarts",
    "chart",
    "visualization",
    "3d",
    "plugin",
    "aigui"
  ],
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git",
    "directory": "packages/plugin-chart"
  },
  "homepage": "https://github.com/liliang-cn/aigui#readme",
  "bugs": "https://github.com/liliang-cn/aigui/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "@ai-gui/core": "0.20.1"
  },
  "peerDependencies": {
    "echarts-gl": "^2.0.9"
  },
  "peerDependenciesMeta": {
    "echarts-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "echarts-gl": "^2.0.9"
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm --dir ../.. exec vitest run --project plugin-chart",
    "typecheck": "tsc --noEmit"
  }
}